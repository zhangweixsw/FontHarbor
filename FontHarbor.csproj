<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>FontHarbor</AssemblyName>
    <RootNamespace>FontHarbor</RootNamespace>
    <Product>字港字体管理器</Product>
    <Company>MooTop · mootop.top</Company>
    <Version>1.3.17</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
    <EmbeddedResource Include="Assets\windows-font-catalog.json" />
    <Compile Remove="validation\**\*.cs" />
    <None Remove="validation\**" />
  </ItemGroup>
</Project>

