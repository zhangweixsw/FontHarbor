<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FontHarbor.MainWindow" Title="字港 1.3.17 · Font Harbor" Icon="Assets/app-icon.ico" Width="1480" Height="860" MinWidth="1180" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="9" ClipToBounds="True" Margin="0,0,10,0">
          <Image Source="{StaticResource BrandIcon}" Stretch="UniformToFill" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="字港" FontSize="21" FontWeight="Normal" Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="Font Harbor · 本机字体工作台" Foreground="{StaticResource TextSecondary}" FontSize="13" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Width="150" TextChanged="FilterChanged" ToolTip="搜索名称、文件或标签" />
        <Button x:Name="ApiSettingsButton" Style="{StaticResource QuietButton}" Content="API 设置" Click="ApiSettings_Click" /><Button x:Name="TagScanButton" Style="{StaticResource QuietButton}" Content="AI 标注" Click="TagScan_Click" /><Button x:Name="PinButton" Style="{StaticResource QuietButton}" Content="窗口置顶" Click="Pin_Click" />
        <Button x:Name="CompactButton" Content="精简模式" Click="Compact_Click" />
        <Button x:Name="RefreshFontsButton" Style="{StaticResource QuietButton}" Content="刷新字体" Click="Refresh_Click" />
        <Button x:Name="BackupSettingsButton" Style="{StaticResource QuietButton}" Content="备份设置" Click="Settings_Click" />
      </StackPanel>
    </Grid>

    <Grid x:Name="WorkspaceShell" Grid.Row="1" Grid.RowSpan="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="CompactCategoryColumn" Width="200" MinWidth="160" MaxWidth="300" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="CompactCategoryPanel" Margin="0" Padding="10,15,10,10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="清除" Click="ClearFacetFilters_Click" Padding="7,3" FontSize="11" /><TextBlock Text="分类与标签" VerticalAlignment="Center" /></DockPanel>
<Border x:Name="CustomCategoryCard" Style="{StaticResource SidebarCard}"><StackPanel>
<TextBlock Text="自定义分类" Style="{StaticResource PrimarySidebarHeading}"/>
<ListBox x:Name="CompactCategoryList" Style="{StaticResource SidebarFacetList}" PreviewMouseLeftButtonDown="Facet_PreviewMouseLeftButtonDown" SelectionChanged="CompactCategory_Changed" ItemsSource="{Binding CompactCategories}" SelectedValuePath="Name"/>
</StackPanel></Border>
<Border x:Name="BasicCategoryCard" Style="{StaticResource SidebarCard}"><StackPanel>
<TextBlock Text="基础类型" Style="{StaticResource PrimarySidebarHeading}"/>
<ListBox x:Name="BasicTagList" Style="{StaticResource SidebarFacetList}" PreviewMouseLeftButtonDown="Facet_PreviewMouseLeftButtonDown" SelectionChanged="TagFacet_Changed" />
</StackPanel></Border>
<TextBlock x:Name="StyleSectionHeading" Text="风格标签" Style="{StaticResource PrimarySidebarHeading}" Margin="10,8,0,8"/><WrapPanel x:Name="StyleFilterSummary" Margin="4,0,0,3" Visibility="Collapsed"/><StackPanel x:Name="StyleGroupsHost"/>
<TextBlock x:Name="AuxiliarySectionHeading" Text="辅助筛选" Style="{StaticResource PrimarySidebarHeading}" Margin="10,8,0,8"/><Border x:Name="AttributeCategoryCard" Style="{StaticResource SidebarCard}"><StackPanel>
<TextBlock Text="字体属性" Style="{StaticResource SidebarHeading}"/>
<ListBox x:Name="AttributeTagList" Style="{StaticResource SidebarFacetList}" PreviewMouseLeftButtonDown="Facet_PreviewMouseLeftButtonDown" SelectionChanged="TagFacet_Changed" />
</StackPanel></Border>
<Border x:Name="StatusCategoryCard" Style="{StaticResource SidebarCard}"><Border.Resources><SolidColorBrush x:Key="CategoryInk" Color="#A591BB"/><SolidColorBrush x:Key="CategoryBackground" Color="#F8F5FC"/><SolidColorBrush x:Key="CategorySelected" Color="#EEE8F6"/><SolidColorBrush x:Key="CategoryBorder" Color="#E8E2EF"/></Border.Resources><StackPanel>
<TextBlock Text="标注状态" Style="{StaticResource SidebarHeading}"/>
<ListBox x:Name="TagStatusList" Style="{StaticResource SidebarFacetList}" PreviewMouseLeftButtonDown="Facet_PreviewMouseLeftButtonDown" SelectionChanged="TagFacet_Changed" />
</StackPanel></Border>
</StackPanel></ScrollViewer></Border><GridSplitter x:Name="CategorySplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="CategorySplitter_DragCompleted" ToolTip="拖动调整分类栏宽度" Background="Transparent"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border x:Name="Grip" Width="3" Height="44" CornerRadius="2" Background="{StaticResource Border}" VerticalAlignment="Center" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template></GridSplitter><TabControl Grid.Column="2" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" x:Name="Tabs" SelectionChanged="SourceTab_Changed">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TabPanel x:Name="SourceHeaders" IsItemsHost="True" Visibility="{Binding SourceTabsVisibility}" KeyboardNavigation.TabIndex="1" />
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
        </Grid></ControlTemplate></TabControl.Template>
      <TabItem Header="已安装字体" HeaderTemplate="{StaticResource IconLabel}">
        <Grid x:Name="LibraryLayout" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LibraryColumn" Width="5*" MinWidth="400" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition x:Name="DetailColumn" Width="300" MinWidth="280" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

              <WrapPanel x:Name="LibraryTools" Visibility="Collapsed" /><Border Grid.Row="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,1" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                  <TextBlock Text="预览文字" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox x:Name="ListPreviewInput" Grid.Column="1" Text="字体设计 Typography 012345" TextChanged="ListPreviewOptionsChanged" />
                  <TextBlock Grid.Column="2" Text="字号" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,8,0" />
                  <Slider x:Name="ListSizeSlider" Grid.Column="3" Minimum="16" Maximum="36" Value="24" TickFrequency="2" ValueChanged="ListPreviewOptionsChanged" />
                </Grid>
              </Border>

              <DataGrid x:Name="FontsGrid" SizeChanged="FontsGrid_SizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2" AutoGenerateColumns="False" SelectionMode="Extended" SelectionChanged="FontsGrid_SelectionChanged" PreviewKeyDown="FontsGrid_PreviewKeyDown" IsReadOnly="False" RowHeight="68" SelectionUnit="FullRow">
                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="对比所选字体" Click="CompareFonts_Click" /><MenuItem Header="最近应用" Click="RecentFonts_Click" /></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="选择" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Click="ItemCheck_Click" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="选择此字体">
                          <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.2" ScaleY="1.2" /></CheckBox.LayoutTransform>
                        </CheckBox>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="字体样张" Width="*" MinWidth="180" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid VerticalAlignment="Center">
                          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                          <TextBlock Text="{Binding DataContext.ListPreviewText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontFamily="{Binding PreviewFamily}" FontWeight="{Binding RenderWeight}" FontStyle="{Binding RenderFontStyle}" FontSize="{Binding DataContext.ListPreviewSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Row="1" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProtectionReason}">
                            <Run Text="{Binding FamilyName}" /><Run Text="  ·  " /><Run Text="{Binding StyleName}" /><Run Text="  ·  " /><Run Text="{Binding TagsText}" /><Run Text="  ·  " /><Run Text="{Binding ProtectionBadge, Mode=OneWay}" />
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="分类" Binding="{Binding CategoriesText}" Width="*" IsReadOnly="True" Visibility="Collapsed" />
                  <DataGridTextColumn Header="状态" Binding="{Binding ProtectionText}" Width="95" IsReadOnly="True" Visibility="Collapsed" />
                  <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="72" IsReadOnly="True" Visibility="Collapsed" />
                  <DataGridTemplateColumn Header="应用" Width="96" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="应用 ↗" ContentTemplate="{x:Null}" Width="68" Margin="0" VerticalAlignment="Center" Padding="7,6" Click="ApplyInstalled_Click" ToolTip="应用到 Illustrator 当前选中的文字" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <Grid x:Name="LibraryManagement" Grid.Row="3" Margin="10"><WrapPanel>
<Button Content="对比所选" Click="CompareFonts_Click" Padding="9,7" Margin="0,0,5,5" /><Button Content="最近应用" Click="RecentFonts_Click" Padding="9,7" Margin="0,0,5,5" /><Button Content="全选当前" Click="SelectVisible_Click" Padding="9,7" Margin="0,0,5,5" /><Button Content="反选" Click="InvertVisible_Click" Padding="9,7" Margin="0,0,5,5" /><Button Content="清空选择" Click="ClearSelection_Click" Padding="9,7" Margin="0,0,5,5" />
<Button Content="系统字体保护" Click="ScanSystemFonts_Click" Padding="9,7" Margin="0,0,5,5" ToolTip="重新扫描并查看 Windows 自动保护字体与原因" /><Button Content="解锁所选" Click="UnlockSelected_Click" Padding="9,7" Margin="0,0,5,5" />
<Button x:Name="LockCategoryButton" Content="锁定/解锁分类" Click="ToggleCategoryLock_Click" Padding="9,7" Margin="0,0,5,5" />
<Button Content="加入分类" Click="Category_Click" Padding="9,7" Style="{StaticResource PrimaryButton}" Margin="0,0,5,5" />
<Button x:Name="DeleteFontsButton" Content="备份并删除" Click="Delete_Click" Padding="9,7" Style="{StaticResource DangerButton}" Margin="0,0,5,5" />
<TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="4,0,8,5" /><TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
</WrapPanel></Grid></Grid>
          </Border>

          <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

          <Border x:Name="LibraryDetails" Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18"><TextBlock x:Name="PreviewTitle" Text="选择字体即可预览" FontSize="18" FontWeight="Normal" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PreviewPath" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><TextBlock Text="{Binding SelectedItem.ProtectionReason, ElementName=FontsGrid}" Foreground="#809AB9" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
              <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="15" Margin="0,18,0,14" MinHeight="125"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="PreviewText" Text="字体之美 Typography 0123456789" FontSize="32" TextWrapping="Wrap" MaxWidth="300" Foreground="{StaticResource TextPrimary}" />
                </Viewbox></Border><TextBox x:Name="PreviewInput" Text="字体之美 Typography 0123456789" TextChanged="PreviewOptionsChanged" Visibility="Collapsed" />

              <Slider x:Name="SizeSlider" Minimum="12" Maximum="96" Value="42" ValueChanged="PreviewOptionsChanged" Visibility="Collapsed" />
              <ComboBox x:Name="PreviewStyleCombo" SelectedIndex="0" SelectionChanged="PreviewOptionsChanged" Visibility="Collapsed">
                  <ComboBoxItem Content="常规" Tag="Regular" /><ComboBoxItem Content="粗体" Tag="Bold" />
                  <ComboBoxItem Content="斜体" Tag="Italic" /><ComboBoxItem Content="粗斜体" Tag="BoldItalic" />
                </ComboBox>
                <TextBlock x:Name="CoverageText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12" /><StackPanel x:Name="InstalledTagEditor" Margin="0,0,0,20" /><Expander Header="字符表" Margin="0,16,0,0"><ItemsControl x:Name="GlyphGrid">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="42" Height="42" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="1" CornerRadius="3">
                          <TextBlock Text="{Binding}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander></StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="ExternalTab" Header="备份 / 文件夹预览" HeaderTemplate="{StaticResource IconLabel}">
        <Grid Margin="16,12,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="扫描备份目录" Click="ScanBackupFolder_Click" />
            <Button Content="添加任意文件夹" Click="AddFontFolder_Click" />
            <Button Content="重新扫描" Click="RescanFolder_Click" />
            <Button x:Name="CancelFolderButton" Content="取消" Click="CancelFolder_Click" IsEnabled="False" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="FontFolderCombo" SelectionChanged="FontFolder_Changed" ToolTip="已添加的字体文件夹" />
            <TextBox Grid.Column="1" x:Name="ExternalSearch" TextChanged="ExternalFilter_Changed" ToolTip="搜索字体名称或路径" Margin="10,0,0,0" />
          </Grid>
          <TextBox Grid.Row="2" x:Name="ExternalPreviewInput" Text="字里行间，皆是灵感。 Typography 012345" TextChanged="ExternalPreview_Changed" Margin="0,0,0,12" ToolTip="自定义样张文字" />
          <DataGrid Grid.Row="3" x:Name="ExternalGrid" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="100" SelectionChanged="ExternalTagSelection_Changed" SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="字体样张 · 无需安装" Width="3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                <TextBlock Text="{Binding DataContext.ExternalPreviewText, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{Binding PreviewFamily}" FontWeight="{Binding Weight}" FontStyle="{Binding Slant}" FontSize="28" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
              </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="65" />
              <DataGridTemplateColumn Header="操作" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="安装并应用 ↗" VerticalAlignment="Center" Click="InstallExternal_Click" Padding="10,7" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="4" x:Name="ExternalStatus" Margin="0,12,0,0" Text="添加文件夹后递归扫描 TTF / OTF / TTC / OTC。备份目录同样支持未生成恢复清单的字体。" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Column="1" Grid.RowSpan="5" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ExternalTagEditor" /></ScrollViewer></Grid>
      </TabItem>

      <TabItem Header="Illustrator 字体检查" HeaderTemplate="{StaticResource IconLabel}">
        <Border Margin="0,12,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="扫描路径" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="移除当前行" Click="RemoveAiFolder_Click" Margin="8,0,0,0" ToolTip="点击路径中的一行，再移除该文件夹" /><TextBox x:Name="AiScanPathBox" IsReadOnly="True" Height="76" VerticalScrollBarVisibility="Auto" ToolTip="包含子目录；重叠路径中的文件只扫描一次" /></DockPanel>
              <Button Grid.Column="2" Content="添加文件夹" Click="BrowseAiFolder_Click" Margin="8,0,0,0" />
              <Button x:Name="ScanAiButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="扫描 .ai 文件" Click="ScanAi_Click" Margin="8,0,0,0" />
              <Button x:Name="CancelAiScanButton" Grid.Column="4" Content="取消扫描" Click="CancelAiScan_Click" IsEnabled="False" Margin="8,0,0,0" />
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,1" Padding="16,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="AiScanStatusText" Text="只读扫描：不会修改、移动或删除目录中的任何文件。" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <WrapPanel Margin="0,8,0,0">
                  <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox x:Name="AiSearchBox" Width="180" TextChanged="AiFilter_Changed" ToolTip="搜索字体名称、匹配名称或引用路径" />
                  <ComboBox x:Name="AiStatusFilter" Width="155" Margin="8,0,0,0" SelectionChanged="AiFilter_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="全部状态" /><ComboBoxItem Content="已安装（全部）" /><ComboBoxItem Content="已安装 · 未锁定" /><ComboBoxItem Content="已安装 · 已锁定" /><ComboBoxItem Content="缺失（全部）" /><ComboBoxItem Content="缺失 · 备份可安装" /><ComboBoxItem Content="缺失 · 无备份" />
                  </ComboBox><TextBlock x:Name="AiFilterCountText" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button Content="全选已安装" Click="SelectAllAiMatches_Click" Margin="0" Padding="10,6" />
                  <Button Content="全选备份可安装" Click="SelectAllAiBackups_Click" Margin="6,0,0,0" Padding="10,6" />
                  <Button Content="清空" Click="ClearAiSelection_Click" Margin="6,0,0,0" Padding="10,6" />
                </StackPanel>
              </Grid>
            </Border>
            <DataGrid x:Name="AiResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" RowHeight="46">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" Width="58" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Illustrator 字体名称" Binding="{Binding FontName}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="本机 / 备份匹配字体" Binding="{Binding InstalledName}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="状态" Binding="{Binding MatchStatus}" Width="160" IsReadOnly="True" />
                <DataGridTextColumn Header="引用文件数" Binding="{Binding FileCount}" Width="90" IsReadOnly="True" />
                <DataGridTemplateColumn Header="引用文件" Width="3*" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FilesText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilesText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="14,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="缺失字体会在当前备份目录中自动查找。" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="从备份安装选中缺失字体" Click="InstallAiFontsFromBackup_Click" />
              <Button Grid.Column="2" Content="在字体库中选中" Click="SelectAiFontsInLibrary_Click" Margin="8,0,0,0" />
              <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="加入分类并锁定" Click="AddAiFontsToLockedCategory_Click" Margin="8,0,0,0" />
            </Grid>
          </Grid>
        </Border>
      </TabItem>

      <TabItem Header="备份与恢复" HeaderTemplate="{StaticResource IconLabel}">
        <Border Margin="0,12,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="14">
              <TextBlock x:Name="BackupPathText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="恢复选中字体" Click="Restore_Click" />
            </DockPanel>
            <DataGrid x:Name="BackupsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="字体" Binding="{Binding DisplayName}" Width="2*" />
                <DataGridTextColumn Header="备份时间" Binding="{Binding BackupTime}" Width="160" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="140" />
                <DataGridTextColumn Header="原位置" Binding="{Binding OriginalPath}" Width="2*" />
                <DataGridTextColumn Header="备份文件" Binding="{Binding BackupPath}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="2,9,0,0">
      <DockPanel><Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="检查更新" ContentTemplate="{x:Null}" Click="CheckUpdate_Click" Padding="6,0" Margin="10,0,0,0"/><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"><Hyperlink NavigateUri="https://mootop.top/" RequestNavigate="MooTop_RequestNavigate">mootop.top ↗</Hyperlink></TextBlock><TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondary}" Text="就绪" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
  </Grid>
</Window>

